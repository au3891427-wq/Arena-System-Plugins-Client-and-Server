# Required Telegram bot configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Set this after Railway generates an HTTPS domain.
# Example: https://your-service.up.railway.app
PUBLIC_BASE_URL=

# Required to enable AI chat. Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Stable public distribution repository
GITHUB_REPOSITORY=au3891427-wq/Arena-System-Plugins-Client-and-Server

# Railway provides PORT automatically. Set only for local development.
PORT=3000

# Optional: restrict commands to comma-separated Telegram chat IDs.
# Leave empty to allow users to chat with the bot.
TELEGRAM_ALLOWED_CHAT_IDS=
