{
  "manifest_version": 3,
  "name": "ArenaSystem Telegram Announcer",
  "version": "1.1.1",
  "description": "Kirim pengumuman JSON terstruktur dari ChatGPT ke topic Update Telegram ArenaSystem.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://arenasystem-telegram-bot-production.up.railway.app/*"
  ],
  "action": {
    "default_title": "Kirim pengumuman ArenaSystem",
    "default_popup": "popup.html"
  }
}
